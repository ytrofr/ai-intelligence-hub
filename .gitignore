# Environment variables (secrets)
.env
*.env

# Database files (generated at runtime)
*.db
*.db-shm
*.db-wal

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Internal project context (not for public repo)
handoffs/
screenshots/
# Adoption radar DATA - same class as handoffs/: names internal source paths,
# line numbers and architecture of private products. Code (routes/, public/) is public;
# the verdict rows are not. Schema: config/radar/example.json
config/radar/*.json
!config/radar/example*.json
# Local project portfolio config - copy projects.example.json and customize
config/projects.json
# Stack Ledger dependency backfill - generated by scripts/ledger-backfill.js from
# the LOCAL manifests, so it names private repo paths and package sets. Same class
# as config/radar/*.json: the code is public, the inventory of what we run is not.
config/ledger/

# Generated at runtime (not for public repo)
digests/*.md
fetch.log
.claude/state/
digest.log

# Working context, not public artifacts. CLAUDE.md named all nine project ids,
# their stacks and the internal API surface; .claude/rules/ and settings.json
# are this machine's session config. Both stay on disk - they are ignored, not
# deleted. The two rules here that were genuinely reusable knowledge rather
# than internal context live in docs/, scrubbed.
CLAUDE.md
.claude/
