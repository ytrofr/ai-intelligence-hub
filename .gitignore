# Environment variables (secrets)
.env
*.env

# Database files (generated at runtime)
*.db
*.db-shm
*.db-wal

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Internal project context (not for public repo)
handoffs/
screenshots/
# Adoption radar DATA - same class as handoffs/: names internal source paths,
# line numbers and architecture of private products. Code (routes/, public/) is public;
# the verdict rows are not. Schema: config/radar/example.json
config/radar/*.json
!config/radar/example.json
# Local project portfolio config - copy projects.example.json and customize
config/projects.json

# Generated at runtime (not for public repo)
digests/*.md
fetch.log
.claude/state/
digest.log
