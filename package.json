{
  "name": "ai-intelligence-hub",
  "version": "2.0.0",
  "description": "AI Intelligence Hub - Modular Trends Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
